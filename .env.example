# MAXGLOW ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and replace placeholders with actual values
# DO NOT commit the .env file to version control

# ----------------------------------------
# 1. APPLICATION ENVIRONMENT
# ----------------------------------------
NODE_ENV=production
PORT=7052
CLIENT_URL=https://maxglow.in
FRONTEND_URL=https://maxglow.in,https://www.maxglow.in,http://localhost:3000
COOKIE_DOMAIN=.maxglow.in

# ----------------------------------------
# 2. NEXT.JS FRONTEND (Requires NEXT_PUBLIC_ prefix)
# ----------------------------------------
NEXT_PUBLIC_APP_URL=https://maxglow.in
NEXT_PUBLIC_API_URL=https://maxglow.in/api
NEXT_PUBLIC_APP_VERSION=3.0.1

# ----------------------------------------
# 3. MONGODB DATABASE [REQUIRED]
# ----------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/maxglow

# ----------------------------------------
# 4. SECURITY & AUTHENTICATION [REQUIRED]
# ----------------------------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ----------------------------------------
# 5. AWS S3 (Images & Media)
# ----------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-s3-bucket-name

# ----------------------------------------
# 6. NODEMAILER (Email Service)
# ----------------------------------------
EMAIL_FROM=noreply@maxglow.in
# (Add standard SMTP credentials here if your mail.js utilizes EMAIL_HOST, EMAIL_USER, etc.)

# ----------------------------------------
# 7. ICICI PAYMENT GATEWAY (Required in Production)
# ----------------------------------------
ICICI_MERCHANT_ID=your_icici_merchant_id
ICICI_SECURE_HASH_KEY=your_icici_hash_key
ICICI_AGGREGATOR_ID=your_icici_aggregator_id
ICICI_INITIATE_SALE_URL=https://eazypay.icicibank.com/EazyPG
ICICI_REFUND_URL=https://eazypay.icicibank.com/refund

# ----------------------------------------
# 8. DELHIVERY (Shipping & Logistics)
# ----------------------------------------
ACTIVE_SHIPPING_PROVIDER=delhivery
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_WEBHOOK_SECRET=your_webhook_secret

# ----------------------------------------
# 9. HTTPS (Only required if running Node server directly on HTTPS instead of Nginx)
# ----------------------------------------
# SSL_KEY_PATH=/etc/letsencrypt/live/maxglow.in/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/maxglow.in/fullchain.pem
