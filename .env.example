# Server Configuration
PORT=7052
NODE_ENV=development # Set to 'production' in production environments
COOKIE_SECURE=false # Set to 'true' in production if NODE_ENV cannot be 'production'
COOKIE_DOMAIN=.maxglow.in # Set to your production domain

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/maxglow

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Media Storage Configuration (AWS S3)
# Leave blank to automatically use local server storage fallback (/public/uploads)
# To use centralized S3 bucket storage for production, populate these:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1

# Delhivery Configuration
DELHIVERY_API_TOKEN=YOUR_MAXGLOW_DELHIVERY_TOKEN
DELHIVERY_BASE_URL=https://track.delhivery.com
BACKEND_URL=http://127.0.0.1:7052
